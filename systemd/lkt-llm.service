[Unit]
Description=Local Knowledge Terminal Qwen model server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=lachlan
Group=lachlan
WorkingDirectory=/home/lachlan/LocalKnowledgeTerminal
Environment=OPENBLAS_NUM_THREADS=4
ExecStart=/home/lachlan/LocalKnowledgeTerminal/runtime/llama.cpp-0.3.0/build/bin/llama-server \
  --model /home/lachlan/LocalKnowledgeTerminal/models/Qwen3-4B-Q4_K_M.gguf \
  --ctx-size 4096 \
  --threads 4 \
  --threads-batch 4 \
  --batch-size 256 \
  --ubatch-size 64 \
  --parallel 1 \
  --host 127.0.0.1 \
  --port 8081 \
  --jinja
Restart=on-failure
RestartSec=5
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/lachlan/LocalKnowledgeTerminal/models /home/lachlan/LocalKnowledgeTerminal/logs

[Install]
WantedBy=multi-user.target
