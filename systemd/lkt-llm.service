[Unit]
Description=Local Knowledge Terminal Qwen model server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=lachlan
Group=lachlan
WorkingDirectory=/home/lachlan/LocalKnowledgeTerminal
Environment=OPENBLAS_NUM_THREADS=4
Environment=LKT_MODEL_PATH=/home/lachlan/LocalKnowledgeTerminal/models/Qwen3-4B-Q4_K_M.gguf
Environment=LKT_MODEL_CONTEXT=3072
Environment=LKT_BATCH_SIZE=128
Environment=LKT_UBATCH_SIZE=64
EnvironmentFile=-/etc/lkt-model.env
ExecStart=/home/lachlan/LocalKnowledgeTerminal/runtime/llama.cpp-0.3.0/build/bin/llama-server \
  --model ${LKT_MODEL_PATH} \
  --ctx-size ${LKT_MODEL_CONTEXT} \
  --threads 4 \
  --threads-batch 4 \
  --batch-size ${LKT_BATCH_SIZE} \
  --ubatch-size ${LKT_UBATCH_SIZE} \
  --cache-ram 256 \
  --ctx-checkpoints 4 \
  --sleep-idle-seconds 600 \
  --parallel 1 \
  --host 127.0.0.1 \
  --port 8081 \
  --jinja
Restart=on-failure
RestartSec=5
TimeoutStartSec=300
MemoryAccounting=true
MemoryHigh=5G
MemoryMax=6G
MemorySwapMax=128M
OOMPolicy=stop
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/lachlan/LocalKnowledgeTerminal/models /home/lachlan/LocalKnowledgeTerminal/logs

[Install]
WantedBy=multi-user.target
